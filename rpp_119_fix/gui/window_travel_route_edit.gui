window = {
	name = "travel_route_edit_window"
	parentanchor = top|right
	position = { 0 70 }
	size = { 500 780 }
	movable = no

	using = Window_Background
	using = Window_Decoration

	datacontext = "[TravelRouteEditWindow.GetTravelPlanData]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		position_x = 0
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Standard
		position_x = 200
	}

	vbox = {
		using = Window_Margins

		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text" {
				text = "TRAVEL_EDIT_ROUTE_HEADER"
			}
			blockoverride "button_close" {
				onclick = "[TravelRouteEditWindow.Close]"
				shortcut = "close_window"
			}
		}

		vbox = {
			name = "contents"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			spacing = 10

			text_multi = {
				name = "instruction_text"

				text = "TRAVEL_EDIT_ROUTE_INSTRUCTION"
				align = center|nobaseline
				autoresize = yes
				default_format = "#I"
				max_width = 380

				margin = { 15 10 }

				background = {
					using = Background_Area_Dark
				}
			}

			scrollbox = {
				name = "route_scroll"
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				blockoverride "scrollbox_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8

							button_fixed_departure = {
								layoutpolicy_horizontal = expanding
							}
						}

						vbox = {
							name = "route_destinations_list"
							layoutpolicy_horizontal = expanding
							spacing = 8
							datamodel = "[TravelPlanData.GetDestinations]"

							item = {
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 8

									vbox = {
										name = "detours_between_destinations"
										visible = "[Not( IsDataModelEmpty( TravelPlanDestination.GetWaypoints ) )]"

										layoutpolicy_horizontal = expanding
										datamodel = "[TravelPlanDestination.GetWaypoints]"

										item = {
											vbox = {
												layoutpolicy_horizontal = expanding

												hbox_add_detour_here = {
													visible = "[TravelRouteEditWindow.IsSelectingProvinceAt( TravelPlanDestination.GetIndex, TravelPlanWaypoint.GetIndex )]"
													layoutpolicy_horizontal = expanding
												}

												hbox_added_detour = {
													visible = "[Or( GetVariableSystem.Exists( TravelPlanDestination.GetProvince.GetTag ), EqualTo_int32( TravelPlanWaypoint.GetIndex, Subtract_int32( GetDataModelSize( TravelPlanDestination.GetWaypoints ), '(int32)1' ) ) )]"
													layoutpolicy_horizontal = expanding
												}
											}
										}
									}

									hbox = {
										name = "detour_toggle_container"
										visible = "[GreaterThan_int32( GetDataModelSize( TravelPlanDestination.GetWaypoints ), '(int32)1' )]"
										layoutpolicy_horizontal = expanding
										margin_left = 32
										margin_right = 10

										button_tertiary_push = {
											name = "toggle_detours_button"
											layoutpolicy_horizontal = expanding
											onclick = "[GetVariableSystem.Toggle( TravelPlanDestination.GetProvince.GetTag )]"
											down = "[GetVariableSystem.Exists( TravelPlanDestination.GetProvince.GetTag )]"
											text = "[SelectLocalization( GetVariableSystem.Exists( TravelPlanDestination.GetProvince.GetTag ), 'TRAVEL_ROUTE_HIDE_DETOURS', 'TRAVEL_ROUTE_SHOW_DETOURS' )]"
											tooltip = "[SelectLocalization( GetVariableSystem.Exists( TravelPlanDestination.GetProvince.GetTag ), 'TRAVEL_ROUTE_HIDE_DETOURS_TT', 'TRAVEL_ROUTE_SHOW_DETOURS_TT' )]"
										}
									}

									hbox_add_detour_here = {
										visible = "[TravelRouteEditWindow.IsSelectingProvinceBeforeDestination( TravelPlanDestination.GetIndex )]"
										layoutpolicy_horizontal = expanding
									}

									button_fixed_destination = {
										layoutpolicy_horizontal = expanding
									}
								}
							}
						}

						vbox = {
							name = "poi_summary_container"
							visible = no
							layoutpolicy_horizontal = expanding
							margin = { 15 8 }
							spacing = 4

							background = {
								using = Background_Area_Dark
							}

							background = {
								using = Background_Frame
								color = { 0.72 0.58 0.18 0.85 }
							}

							hbox = {
								margin = { 8 6 }
								spacing = 6
								layoutpolicy_horizontal = expanding

								text_single = {
									raw_text = "✓"
									default_format = "#bold;high"
									align = nobaseline
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "RPP_ROUTE_POI_HEADER"
									default_format = "#bold;high"
									align = left|nobaseline
								}
							}

							vbox = {
	margin_left = 10
	margin_right = 10
	margin_bottom = 4
	spacing = 1
	layoutpolicy_horizontal = expanding

	text_single = {
		raw_text = "SUMMARY total=[GetPlayer.MakeScope.Var('rpp_route_score_total').GetValue|0] poi=[GetPlayer.MakeScope.Var('rpp_route_poi_count').GetValue|0]"
		default_format = "#bold"
		align = left|nobaseline
	}

	text_single = {
		raw_text = "DIP=[GetPlayer.MakeScope.Var('rpp_route_score_diplomacy').GetValue|0] MAR=[GetPlayer.MakeScope.Var('rpp_route_score_martial').GetValue|0] STE=[GetPlayer.MakeScope.Var('rpp_route_score_stewardship').GetValue|0]"
		default_format = "#weak"
		align = left|nobaseline
	}

	text_single = {
		raw_text = "INT=[GetPlayer.MakeScope.Var('rpp_route_score_intrigue').GetValue|0] LEA=[GetPlayer.MakeScope.Var('rpp_route_score_learning').GetValue|0] MSC=[GetPlayer.MakeScope.Var('rpp_route_score_misc').GetValue|0]"
		default_format = "#weak"
		align = left|nobaseline
	}

	text_single = {
		raw_text = "FROM: [TravelPlanData.GetDepartureLocation.GetName]"
		default_format = "#weak"
		align = left|nobaseline
	}

	text_single = {
		raw_text = "DESTINATIONS: [GetDataModelSize( TravelPlanData.GetDestinations )]"
		default_format = "#weak"
		align = left|nobaseline
	}

	text_single = {
		visible = "[TravelPlanData.HasNextDestination]"
		raw_text = "NEXT: [TravelPlanData.GetNextDestination.GetProvince.GetName]"
		default_format = "#weak"
		align = left|nobaseline
	}

	text_single = {
		visible = "[TravelPlanData.HasNextDestination]"
		raw_text = "FINAL: [TravelPlanData.GetFinalDestination.GetProvince.GetName]"
		default_format = "#weak"
		align = left|nobaseline
	}
}

							vbox = {
								layoutpolicy_horizontal = expanding
								margin_left = 10
								margin_right = 10
								margin_bottom = 8
								spacing = 4
								datamodel = "[TravelPlanData.GetDestinations]"

								item = {
									vbox = {
										layoutpolicy_horizontal = expanding
										spacing = 2

										text_single = {
											raw_text = "DEST [TravelPlanDestination.GetIndex]: [TravelPlanDestination.GetProvince.GetName]"
											default_format = "#bold"
											align = left|nobaseline
										}

										text_single = {
											raw_text = "WAYPOINTS: [GetDataModelSize( TravelPlanDestination.GetWaypoints )]"
											default_format = "#weak"
											align = left|nobaseline
										}

										vbox = {
											visible = "[Not( IsDataModelEmpty( TravelPlanDestination.GetWaypoints ) )]"
											layoutpolicy_horizontal = expanding
											margin_left = 12
											spacing = 2
											datamodel = "[TravelPlanDestination.GetWaypoints]"

											item = {
												vbox = {
													layoutpolicy_horizontal = expanding
													spacing = 1

													text_single = {
														raw_text = "WP [TravelPlanWaypoint.GetIndex]: [TravelPlanWaypoint.GetProvince.GetName]"
														default_format = "#weak"
														align = left|nobaseline
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 15 0 }
				margin_bottom = 15

				spacing = 8

				text_multi = {
					name = "error_text"
					visible = "[Not( TravelRouteEditWindow.IsRouteValid )]"

					text = "[TravelRouteEditWindow.GetRouteValidDesc]"
					align = center|nobaseline
					autoresize = yes
					max_width = 380

					margin = { 10 10 }

					background = {
						using = Background_Area_Dark
					}
				}

				hbox = {
					spacing = 10

					button_standard = {
						visible = "[TravelRouteEditWindow.HasTravelStarted]"
						onclick = "[TravelRouteEditWindow.Close]"
						text = CANCEL
					}

					button_primary = {
						enabled = "[TravelRouteEditWindow.IsRouteValid]"
						onclick = "[TravelRouteEditWindow.ApplyChanges]"
						onclick = "[TravelRouteEditWindow.Close]"
						text = "APPLY"
					}
				}
			}
		}
	}
}

types TravelRouteEditTypes
{
	type hbox_add_detour_here = hbox {
		margin_left = 20
		margin_right = 10

		hbox = {
			margin = { 8 8 }
			spacing = 8
			layoutpolicy_horizontal = expanding

			background = {
				using = Background_Area_Dark
			}

			background = {
				using = Background_Frame
				color = { 0.90 0.70 0.20 1.0 }
			}

			text_single = {
				margin = { 8 10 }
				layoutpolicy_horizontal = expanding
				text = "TRAVEL_EDIT_ROUTE_SELECT_PROVINCE"
				default_format = "#bold;high"
				align = nobaseline
			}

			button_cancel = {
				size = { 36 36 }
				onclick = "[TravelRouteEditWindow.StopProvinceSelection]"
			}
		}
	}

	type button_fixed_departure = button {
	datacontext = "[TravelPlanData.GetDepartureLocation]"
	datacontext = "[Province.GetTitle]"
	size = { 0 68 }

	using = State_Title_MouseEntry
		onclick = "[DefaultOnCoatOfArmsRightClick( Title.GetID )]"
		tooltip = "GOTO_PROVINCE_TT"

		hbox = {
			using = travel_stop_bg

			margin = { 10 10 }
			spacing = 8

			coa_title_tiny = {
				datacontext = "[Province.GetCoATitle]"
				using = tooltip_ws
			}

			vbox = {
				text_single = {
					layoutpolicy_horizontal = expanding
					text = "[Province.GetNameNoTooltip]"
					align = nobaseline
					default_format = "#V"
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					text = "TRAVEL_EDIT_ROUTE_FIXED_SUB_LABEL_DEPARTURE"
					align = nobaseline
					default_format = "#weak"
				}
			}

			expand = {}

			vbox = {
				layoutpolicy_vertical = expanding

				button_plus = {
					size = { 42 42 }
					visible = "[TravelRouteEditWindow.CanAddWaypointAfterDeparture]"
					onclick = "[TravelRouteEditWindow.AddWaypointAfterDeparture]"
					tooltip = TRAVEL_EDIT_ROUTE_ADD_DETOUR_TT
					inherit_visual_state = no

					background = {
						using = Background_Area_Dark
						color = { 0.90 0.70 0.20 1.0 }
					}
				}
			}
		}
	}
	
	type button_fixed_destination = button {
	datacontext = "[TravelPlanDestination.GetProvince]"
	datacontext = "[Province.GetTitle]"
	size = { 0 68 }

	using = State_Title_MouseEntry
		onclick = "[DefaultOnCoatOfArmsRightClick( Title.GetID )]"
		tooltip = "GOTO_PROVINCE_TT"

		hbox = {
			using = travel_stop_bg

			background = {
				visible = "[TravelRouteEditWindow.IsSelectingProvinceBeforeDestination( TravelPlanDestination.GetIndex )]"
				using = Background_Frame
				color = { 0.90 0.70 0.20 1.0 }
				margin = { -2 -2 }
			}

			margin = { 10 10 }
			margin_right = 10
			spacing = 8

			coa_title_tiny = {
				datacontext = "[Province.GetCoATitle]"
				using = tooltip_ws
			}

			vbox = {
				text_single = {
					layoutpolicy_horizontal = expanding
					text = "[Province.GetNameNoTooltip]"
					align = nobaseline
					default_format = "#V"
				}

				text_single = {
					datacontext = "[TravelPlanDestination.GetProvince]"
					layoutpolicy_horizontal = expanding
					text = "TRAVEL_EDIT_ROUTE_FIXED_SUB_LABEL"
					align = nobaseline
					default_format = "#weak"
				}
			}

			expand = {}

			vbox = {
				layoutpolicy_vertical = expanding

				button_plus = {
					size = { 42 42 }
					visible = "[TravelRouteEditWindow.CanAddWaypointAfterDestination( TravelPlanDestination.GetIndex )]"
					onclick = "[TravelRouteEditWindow.AddWaypointAfterDestination( TravelPlanDestination.GetIndex )]"
					tooltip = TRAVEL_EDIT_ROUTE_ADD_DETOUR_TT
					inherit_visual_state = no

					background = {
						using = Background_Area_Dark
						color = { 0.90 0.70 0.20 1.0 }
					}
				}
			}
		}
	}
	
	type hbox_added_detour = hbox {
		margin_left = 32
		margin_right = 10

		button = {
			datacontext = "[TravelPlanWaypoint.GetProvince]"
			datacontext = "[Province.GetTitle]"
			layoutpolicy_horizontal = expanding
			size = { 0 60 }

			using = State_Title_MouseEntry
			onclick = "[DefaultOnCoatOfArmsRightClick( Title.GetID )]"
			tooltip = "GOTO_PROVINCE_TT"

			hbox = {
				using = travel_stop_bg

				background = {
					using = Background_Frame
					color = { 0.72 0.58 0.18 0.85 }
					margin = { -1 -1 }
				}

				background = {
					visible = "[TravelRouteEditWindow.IsSelectingProvinceAt( TravelPlanDestination.GetIndex, TravelPlanWaypoint.GetIndex )]"
					using = Background_Frame
					color = { 0.90 0.70 0.20 1.0 }
					margin = { -3 -3 }
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 8 }
					spacing = 8

					coa_title_tiny = {
						visible = "[Province.GetCoATitle.IsValid]"
						datacontext = "[Province.GetCoATitle]"
						using = tooltip_ws
					}

					widget = {
						visible = "[Not( Province.GetCoATitle.IsValid )]"
						size = { 42 42 }

						icon = {
							parentanchor = center
							texture = "[Province.GetTerrain.GetIcon]"
							position = { 1 0 }
							size = { 35 35 }
						}
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "[Province.GetNameNoTooltip]"
						align = nobaseline
						max_width = 220
						default_format = "#V"
					}

					button_cancel = {
						visible = "[TravelRouteEditWindow.CanRemoveWaypoint( TravelPlanDestination.GetIndex, TravelPlanWaypoint.GetIndex )]"
						onclick = "[TravelRouteEditWindow.RemoveWaypoint( TravelPlanDestination.GetIndex, TravelPlanWaypoint.GetIndex )]"
						tooltip = TRAVEL_EDIT_ROUTE_REMOVE_DETOUR_TT
						inherit_visual_state = no
					}

					expand = {}

					vbox = {
						layoutpolicy_vertical = expanding

						button_plus = {
							size = { 42 42 }
							visible = "[TravelRouteEditWindow.CanAddWaypointAfterWaypoint( TravelPlanDestination.GetIndex, TravelPlanWaypoint.GetIndex )]"
							onclick = "[TravelRouteEditWindow.AddWaypointAfterWaypoint( TravelPlanDestination.GetIndex, TravelPlanWaypoint.GetIndex )]"
							tooltip = TRAVEL_EDIT_ROUTE_ADD_DETOUR_TT
							inherit_visual_state = no

							background = {
								using = Background_Area_Dark
								color = { 0.90 0.70 0.20 1.0 }
							}
						}
					}
				}
			}
		}
	}
}

template travel_stop_bg
{
	background = {
		using = Background_Area_Dark
	}

	background = {
		texture = "[Province.GetIllustration]"
		alpha = 0.6
		fittype = centercrop

		using = Mask_Rough_Edges

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_horizontal_right.dds"
			blend_mode = alphamultiply
			mirror = horizontal
		}
	}
}