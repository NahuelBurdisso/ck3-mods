		# 	name = "gr_book_gutter"
		# 	position = { 674 40 }
		# 	size = { 180 780 }
		# 	texture = "gfx/interface/window_gr_chronicle/gr_book_gutter.dds"
		# 	alpha = 0.40
		# 	alwaystransparent = yes
		# }

		################################################################
		# The dynasty coat of arms for the frontispiece is NOT here yet.
		# My first attempt guessed the getter chain and CK3 rejected both
		# properties. Vanilla only ever renders a dynasty CoA through
		# BookmarkCharacter, so the live-scope chain needs verifying in
		# game before it goes in. It will land with the frontispiece event.
		################################################################
	}
}
