				visible = "[ObjectsEqual( GetPlayer.MakeScope.Var('gr_wm').GetFlagName, 'gr_ek2_watermark_07' )]"
				position = { 823 118 }
				size = { 430 645 }
				texture = "gfx/interface/window_gr_chronicle/watermarks/gr_ek2_watermark_07.dds"
				alpha = 0.45
				alwaystransparent = yes
			}
			icon = {
				visible = "[ObjectsEqual( GetPlayer.MakeScope.Var('gr_wm').GetFlagName, 'gr_ek2_watermark_08' )]"
				position = { 823 118 }
				size = { 430 645 }
				texture = "gfx/interface/window_gr_chronicle/watermarks/gr_ek2_watermark_08.dds"
				alpha = 0.45
				alwaystransparent = yes
			}
			icon = {
				visible = "[ObjectsEqual( GetPlayer.MakeScope.Var('gr_wm').GetFlagName, 'gr_ek2_watermark_09' )]"
				position = { 823 118 }
				size = { 430 645 }
				texture = "gfx/interface/window_gr_chronicle/watermarks/gr_ek2_watermark_09.dds"
				alpha = 0.45
				alwaystransparent = yes
			}
			icon = {
				visible = "[ObjectsEqual( GetPlayer.MakeScope.Var('gr_wm').GetFlagName, 'gr_ek2_watermark_10' )]"
				position = { 823 118 }
				size = { 430 645 }
				texture = "gfx/interface/window_gr_chronicle/watermarks/gr_ek2_watermark_10.dds"
				alpha = 0.45
				alwaystransparent = yes
			}
			icon = {
				visible = "[ObjectsEqual( GetPlayer.MakeScope.Var('gr_wm').GetFlagName, 'gr_ek2_watermark_11' )]"
				position = { 823 118 }
				size = { 430 645 }
				texture = "gfx/interface/window_gr_chronicle/watermarks/gr_ek2_watermark_11.dds"
				alpha = 0.45
				alwaystransparent = yes
			}
			icon = {
				visible = "[ObjectsEqual( GetPlayer.MakeScope.Var('gr_wm').GetFlagName, 'gr_ek2_watermark_12' )]"
				position = { 823 118 }
				size = { 430 645 }
				texture = "gfx/interface/window_gr_chronicle/watermarks/gr_ek2_watermark_12.dds"
				alpha = 0.45
				alwaystransparent = yes
			}
		}


		################################################################
		# LAYER 2a - LEFT PAGE: portrait, name, options.
		################################################################

		# --- ruler portrait ---
		# Ported wholesale from gr_chronicle_window.gui's "Right column -
		# legend-style portrait". Only the datacontext differs: the old
		# scripted GUI had to read the page off a player variable, an event
		# window gets the character handed to it directly.
		#
		# Do NOT go back to portrait_head here. It hardcodes size 110x120 so it
		# ignores its container, and it carries Background_Area_Solid, which
		# paints a black box behind the head. Ruinous on parchment.
		#
		# GetAnimatedPortraitEvenIfDead is the getter that matters: full-body
		# painterly render that still works once the character is a weak scope.
		widget = {
			name = "gr_folio_portrait"
			datacontext = "[EventWindowData.GetPortraitCharacter('left_portrait')]"
			visible = "[EventWindowData.HasPortraitCharacter('left_portrait')]"
			# Centred on the left page: 274 + (441 - 161) / 2 = 414. Top edge sits
			# at 96, clear of the head ornament above it (62..91); bottom stays at
			# 402 so nothing below has to move.
			# Art is natively 400x760 so this is still a downscale. Sized down
			# again to clear the ~130px the ledger needs above the back arrow.
			position = { 414 96 }
			size = { 161 306 }

			background = {
				name = "gr_portrait_gold_bg"
				texture = "gfx/interface/window_legend_chronicle/marginalia_portrait_gold_bg.dds"
			}

			# BEGIN STYLIZE PAIR (generated by scripts/build_portrait.py)
			# CK3 1.20 Stylize Deceased Characters: the first button is shown when the setting is off,
			# the second, identical but for the painterly shader, when it is on (vanilla's own pattern,
			# game/gui/shared/portraits.gui:1324-1341). Beautify needs nothing: it is applied where the
			# portrait is generated.
			portrait_button = {
				name = "gr_folio_portrait_button"
				visible = yes # gui119: 1.19 has no stylize setting
				parentanchor = bottom|hcenter
				size = { 161 306 }
				alpha = 0.80

				using = portrait_base
				alwaystransparent = yes
				tooltip_visible = no

				portrait_texture = "[Character.GetAnimatedPortraitEvenIfDead( 'environment_painterly', 'camera_torso', GetPlayer.MakeScope.Var('gr_folio_pose').GetFlagName, PdxGetWidgetScreenSize( PdxGuiWidget.Self ) )]"

				# CAMERA: the number that matters is the cylindrical radius in
				# gfx/portraits/cameras/portrait_cameras.txt -- lower is closer.
				#   camera_legend_chronicle  400  full body (was this)
				#   camera_torso             240  head and upper body (now)
				#   camera_head              150  face only
				# Torso rather than head because the frame is tall and narrow
				# (161x306); a face-only crop would leave dead space above and below,
				# and would cut the crown and regalia that make a ruler legible.
				#
				# 3rd arg is the POSE. It is NOT a literal: gr_book_set_pose_effect
				# picks one from the ruler's own record during gr_obituary.11's
				# immediate, and GetFlagName hands the flag's name over as a string.
				# Vanilla passes non-literals here too (war_overview uses
				# Select_CString, the council window uses GetPortraitAnimation).
				# It was 'normal', inherited from gr_chronicle_window.gui, which is
				# not a defined animation at all -- the engine had been silently
				# falling back to a default the whole time.
				mask = "gfx/portraits/portrait_mask_legend_chronicle.dds"
				effectname = "NoHighlight"

				pop_out = yes
				pop_out_v = 3.0
				grayscale = no

				blockoverride "portrait_button_template_onmouseenter" {}
				blockoverride "portrait_button_template_onmouseleave" {}
				blockoverride "portrait_button_template_onclick" {}
				blockoverride "portrait_button_template_onrightclick" {}
				blockoverride "portrait_button_template_tooltip" {}
			}

			portrait_button = {
				name = "gr_folio_portrait_button_painted"
				visible = no # gui119: 1.19 has no stylize setting
				parentanchor = bottom|hcenter
				size = { 161 306 }
				alpha = 0.80

				using = portrait_base
				shaderfile = "gfx/FX/gui_painterly_portrait.shader"
				alwaystransparent = yes
				tooltip_visible = no

				portrait_texture = "[Character.GetAnimatedPortraitEvenIfDead( 'environment_painterly', 'camera_torso', GetPlayer.MakeScope.Var('gr_folio_pose').GetFlagName, PdxGetWidgetScreenSize( PdxGuiWidget.Self ) )]"

				# CAMERA: the number that matters is the cylindrical radius in
				# gfx/portraits/cameras/portrait_cameras.txt -- lower is closer.
				#   camera_legend_chronicle  400  full body (was this)
				#   camera_torso             240  head and upper body (now)
				#   camera_head              150  face only
				# Torso rather than head because the frame is tall and narrow
				# (161x306); a face-only crop would leave dead space above and below,
				# and would cut the crown and regalia that make a ruler legible.
				#
				# 3rd arg is the POSE. It is NOT a literal: gr_book_set_pose_effect
				# picks one from the ruler's own record during gr_obituary.11's
				# immediate, and GetFlagName hands the flag's name over as a string.
				# Vanilla passes non-literals here too (war_overview uses
				# Select_CString, the council window uses GetPortraitAnimation).
				# It was 'normal', inherited from gr_chronicle_window.gui, which is
				# not a defined animation at all -- the engine had been silently
				# falling back to a default the whole time.
				mask = "gfx/portraits/portrait_mask_legend_chronicle.dds"
				effectname = "NoHighlight"

				pop_out = yes
				pop_out_v = 3.0
				grayscale = no

				blockoverride "portrait_button_template_onmouseenter" {}
				blockoverride "portrait_button_template_onmouseleave" {}
				blockoverride "portrait_button_template_onclick" {}
				blockoverride "portrait_button_template_onrightclick" {}
				blockoverride "portrait_button_template_tooltip" {}
			}
			# END STYLIZE PAIR
			### Ornate frame overlay, drawn last so it sits in front ###
			icon = {
				name = "gr_portrait_frame_overlay"
				size = { 100% 100% }
				texture = "gfx/interface/window_legend_chronicle/marginalia_portrait_frame_legendary.dds"
				alwaystransparent = yes
			}
		}

		# --- ruler name ---
		text_multi = {
			name = "gr_page_title"
			visible = "[EventWindowData.HasPortraitCharacter('left_portrait')]"
			position = { 292 412 }
			size = { 405 34 }
			max_width = 405
			text = "[EventWindowData.GetTitle]"
			align = center
			fontsize = 24
			default_format = "#light_background"
		}

		# --- reign dates ---
		text_multi = {
			name = "gr_page_dates"
			visible = "[EventWindowData.HasPortraitCharacter('left_portrait')]"
			position = { 292 448 }
			size = { 405 24 }
			max_width = 405
			text = "GR_BOOK_DATES"
			align = center
			fontsize = 15
			default_format = "#light_background"
		}

		################################################################
		# COVER-ONLY left page: house arms, name, motto, dynasty total.
		# The ONLY thing distinguishing the cover from a ruler folio is that
		# gr_book.1 supplies no left_portrait. Everything below is gated on
		# that absence, and the folio's portrait/dates/ledger on its presence,
		# so one window serves both spreads.
		################################################################
		# A house coat of arms needs FIVE things, not one. The shield's shape is
		# culture-specific, supplied as a mask/offset/scale off
		# DynastyHouse.GetCulture.GetTemplateData. Give it only `coat_of_arms`
		# and it parses cleanly, logs nothing, and draws nothing -- which is
		# exactly what happened through three attempts here.
		#
		# Structure copied from vanilla's coa_house_widget usage: the house on an
		# outer datacontext, the culture template on an inner one (contexts stack,
		# so DynastyHouse stays reachable inside), then coa_house_widget with
		# CoA_House_Defaults wrapping the icon and its culture frame.
		#
		# Texture is requested at 230 (a size vanilla actually caches) and drawn
		# larger; the frame/icon ratio 260:195 matches vanilla's 480:360.
		widget = {
			name = "gr_cover_arms"
			visible = "[Not(EventWindowData.HasPortraitCharacter('left_portrait'))]"
			datacontext = "[GetPlayer.GetHouse]"
			# Centred on the left page: 274 + (441 - 260) / 2 = 364.
			position = { 364 98 }
			size = { 260 260 }

			widget = {
				datacontext = "[DynastyHouse.GetCulture.GetTemplateData]"
				size = { 100% 100% }

				coa_house_widget = {
					parentanchor = center
					size = { 260 260 }
					using = CoA_House_Defaults

					# CoA_House_Defaults ships a button whose onclick and tooltip
					# read Character. Here the datacontext is a DynastyHouse, so
					# Character is nobody and clicking opened a blank "Lowborn /
					# Unlanded" character sheet. The arms are decoration on a book
					# page, not a link, so the button is emptied out.
					blockoverride "coa_button" {
						# button_ignore takes both/none/right; 'all' is not a value, and
						# NoOp is not a function. Both errored in the log, so the whole
						# override was discarded and the arms still opened an empty
						# character sheet.
						button_ignore = both
						tooltip_visible = no
					}

					coat_of_arms_icon = {
						parentanchor = center
						size = { 195 195 }
						coat_of_arms = "[DynastyHouse.GetHouseCoA.GetTexture('(int32)230','(int32)230')]"
						coat_of_arms_slot = "[DynastyHouse.GetHouseCoA.GetSlot('(int32)230','(int32)230')]"
						coat_of_arms_mask = "[CultureTemplateData.GetCultureHouseCoAMask]"
						coat_of_arms_offset = "[CultureTemplateData.GetCultureHouseCoAOffset]"
						coat_of_arms_scale = "[CultureTemplateData.GetCultureHouseCoAScale]"

						modify_texture = {
							texture = "gfx/interface/coat_of_arms/coa_overlay.dds"
							blend_mode = overlay
							alpha = 0.4
						}
					}

					coa_house_frame = {
						parentanchor = center
						size = { 260 260 }
						texture = "[CultureTemplateData.GetCultureHouseCoAFrame]"
					}
				}
			}
		}

		text_multi = {
			name = "gr_cover_house"
			visible = "[Not(EventWindowData.HasPortraitCharacter('left_portrait'))]"
			position = { 292 382 }
			size = { 405 40 }
			max_width = 405
			text = "GR_BOOK_HOUSE_NAME"
			align = center
			fontsize = 26
			default_format = "#light_background"
		}

		text_multi = {
			name = "gr_cover_motto"
			visible = "[Not(EventWindowData.HasPortraitCharacter('left_portrait'))]"
			position = { 292 424 }
			size = { 405 60 }
			max_width = 405
			text = "GR_BOOK_HOUSE_MOTTO"
			align = center
			fontsize = 16
			default_format = "#light_background"
		}

		text_multi = {
			name = "gr_cover_total"
			visible = "[Not(EventWindowData.HasPortraitCharacter('left_portrait'))]"
			position = { 292 582 }
			size = { 405 110 }
			max_width = 405
			text = "GR_BOOK_HOUSE_TOTAL"
			align = center
			fontsize = 16
			default_format = "#light_background"
		}

		# --- marginalia rule between the portrait and the ledger ---
		# Vanilla art, natively 1048x80, so 380x29 keeps its aspect.
		icon = {
			name = "gr_page_divider"
			position = { 304 478 }
			size = { 380 29 }
			texture = "gfx/interface/window_legend_chronicle/marginalia_divider.dds"
			alwaystransparent = yes
		}

		################################################################
		# The ruler's realm arms, seated under the rule. coa_realm_medium_crown
		# is vanilla's crowned shield; it reads Character.GetPrimaryTitle off the
		# datacontext, so the remembered ruler's own realm is what appears, and
		# the crown suppresses itself for mercenaries, holy orders and landless
		# adventurers via the type's own blockoverride.
		################################################################
		widget = {
			name = "gr_folio_realm_arms"
			datacontext = "[EventWindowData.GetPortraitCharacter('left_portrait')]"
			# Hidden for TITLELESS entries. Close-family obituaries (Path 2 of
			# gr_is_qualifying_npc) have no landed requirement, so unlanded
			# dynasty members do get chronicled, and coa_realm_medium_crown
			# reads Character.GetPrimaryTitle, which they do not have.
			#
			# Gated on gr_title_count rather than Character.HasLandedTitles:
			# these characters are DEAD and their titles have already passed to
			# an heir, so the live getter is unreliable for them. gr_title_count
			# was recorded at the moment of death and restored onto the player
			# by gr_replay_restore_vars_effect, so it reflects what they actually
			# held when the page was written.
			visible = "[And(EventWindowData.HasPortraitCharacter('left_portrait'), ObjectsEqual( GetPlayer.MakeScope.Var('gr_folio_titled').GetFlagName, 'yes' ))]"
			position = { 292 512 }
			size = { 405 96 }

			coa_realm_medium_crown = {
				parentanchor = center
			}
		}

		# --- the ledger: what the reign actually scored ---
		text_multi = {
			name = "gr_page_ledger"
			visible = "[EventWindowData.HasPortraitCharacter('left_portrait')]"
			position = { 292 616 }
			size = { 405 96 }
			max_width = 405
			text = "GR_BOOK_LEDGER"
			align = center
			fontsize = 15
			default_format = "#light_background"
		}

		################################################################
		# Head ornaments. Vanilla marginalia_divider (natively 1048x80) at
		# reduced alpha, one per page, sitting above the content on both
		# spreads. Same art as the mid-page rule on the folio, so the book
		# reads as one hand throughout.
		#
		# The right-hand one is deliberately BELOW the close X (which lives at
		# y 74) and narrower than the page, so the two never collide.
		################################################################
		icon = {
			name = "gr_left_head_ornament"
			position = { 304 62 }
			size = { 380 29 }
			texture = "gfx/interface/window_legend_chronicle/marginalia_divider.dds"
			alpha = 0.72
			alwaystransparent = yes
		}

		icon = {
			name = "gr_right_head_ornament"
			position = { 836 96 }
			size = { 405 29 }
			texture = "gfx/interface/window_legend_chronicle/marginalia_divider.dds"
			alpha = 0.72
			alwaystransparent = yes
		}

		################################################################
		# LAYER 2b - RIGHT PAGE, the obituary. Scrolls, because a GR
		# obituary will not fit 453 x 717 at a readable size.
		################################################################
		widget = {
			name = "gr_right_page"
			position = { 812 132 }
			size = { 453 643 }

			scrollarea = {
				name = "gr_obituary_scrollarea"
				size = { 100% 100% }
				scrollbarpolicy_horizontal = always_off

				scrollbar_vertical = {
					using = Scrollbar_Vertical
					blockoverride "alpha" {
						alpha = 0.35
					}
				}

				scrollwidget = {
					vbox = {
						layoutpolicy_vertical = expanding
						margin = { 24 20 }

						text_multi = {
							name = "gr_obituary_text"
							layoutpolicy_horizontal = expanding
							max_width = 400
							text = "[EventWindowData.GetDescription]"
							autoresize = yes
							fontsize = 17
							default_format = "#light_background"
							margin = { 0 8 }
						}

						expand = {}
					}
				}
			}
		}

		################################################################
		# ORDER MATTERS BELOW THIS LINE.
		# The right page's scrollarea spans x 812..1265, y 58..775, which
		# geometrically contains BOTH the close X (1199,74) and the forward
		# arrow (1193,712). Declaration order is z-order, so while the page
		# was declared last it sat in front of them and ate their clicks.
		# They still DREW, because the scrollarea's background is transparent,
		# which made it look like the X was simply broken. The buttons must
		# stay declared AFTER the page. Do not move them back up.
		################################################################

		################################################################
		# PAGE NAVIGATION
		#
		# CK3 gives event options exactly TWO internal flags, 'special' and
		# 'dangerous'. There is no way to invent more, so the three buttons
		# are separated as:
		#
		#   special    -> the red X          (top-right of the right page)
		#   dangerous  -> back a page        (bottom-left of the left page)
		#   unflagged  -> forward a page     (bottom-right of the right page)
		#
		# 'dangerous' is being used purely as a channel here, not as a
		# warning. Nothing styles off it because these are hand-rolled
		# button_icons rather than button_eventoption.
		#
		# HARD CAP: three positioned buttons. A fourth option type has
		# nowhere to go and would stack into the forward slot, since
		# unflagged is the catch-all. If we ever need "return to the cover",
		# it has to share a slot or go back to a stacked list.
		#
		# Visibility is NOT handled here. An option whose `trigger` fails is
		# never in GetOptions at all, so the first page simply has no back
		# button and the last has no forward one.
		################################################################

		# --- back a page: bottom-left of the LEFT page (x 274..715) ---
		margin_widget = {
			name = "gr_book_prev"
			parentanchor = top|left
			# Dangerous options are row 1 (close occupies row 0, invisible here
			# but still advancing the grid). 660 + 56 renders the arrow at 716.
			# The cover has no dangerous options, so this draws nothing there.
			position = { 290 660 }
			layer = top
			size = { 56 56 }
			allow_outside = yes

			fixedgridbox = {
				datamodel = "[EventWindowData.GetOptions]"
				addcolumn = 56
				addrow = 56

				item = {
					button_icon = {
						visible = "[EventOption.HasFlag('dangerous')]"
						size = { 48 48 }
						texture = "gfx/interface/icons/flat_icons/window_back.dds"
						color = { 0.22 0.15 0.09 1 }
						onclick = "[EventOption.Select]"
						tooltip = "[EventOption.GetTooltip]"
						using = tooltip_above
					}
				}
			}
		}

		# --- forward: bottom-right of the RIGHT page (x 812..1265) ---
		# The plain option's row differs by spread (ORDER CONTRACT in the
		# events): row 1 on the cover (after close), row 2 on folios (after
		# close and one dangerous). Two sibling grids compensate, gated by the
		# same portrait test the watermark layer already proves reliable.
		margin_widget = {
			name = "gr_book_next_cover"
			visible = "[Not(EventWindowData.HasPortraitCharacter('left_portrait'))]"
			parentanchor = top|left
			position = { 1193 660 }
			layer = top
			size = { 56 168 }
			allow_outside = yes

				fixedgridbox = {
					datamodel = "[EventWindowData.GetOptions]"
					addcolumn = 56
					addrow = 56

					item = {
						button_icon = {
							visible = "[Not(Or(EventOption.HasFlag('special'), EventOption.HasFlag('dangerous')))]"
							size = { 48 48 }
							texture = "gfx/interface/icons/flat_icons/next.dds"
							color = { 0.22 0.15 0.09 1 }
							onclick = "[EventOption.Select]"
							tooltip = "[EventOption.GetTooltip]"
							using = tooltip_above
						}
					}
				}
		}

		margin_widget = {
			name = "gr_book_next_folio"
			visible = "[EventWindowData.HasPortraitCharacter('left_portrait')]"
			parentanchor = top|left
			position = { 1193 604 }
			layer = top
			size = { 56 224 }
			allow_outside = yes

				fixedgridbox = {
					datamodel = "[EventWindowData.GetOptions]"
					addcolumn = 56
					addrow = 56

					item = {
						button_icon = {
							visible = "[Not(Or(EventOption.HasFlag('special'), EventOption.HasFlag('dangerous')))]"
							size = { 48 48 }
							texture = "gfx/interface/icons/flat_icons/next.dds"
							color = { 0.22 0.15 0.09 1 }
							onclick = "[EventOption.Select]"
							tooltip = "[EventOption.GetTooltip]"
							using = tooltip_above
						}
					}
				}
		}


		################################################################
		# Red X, top-right of the RIGHT page.
		# This is a real event option rather than a window close, so
		# selecting it runs gr_obituary.11's after block. Closing the
		# window directly would skip that cleanup and leave the chronicle
		# window rendering from variables that were just cleared.
		################################################################
		margin_widget = {
			name = "gr_book_close"
			parentanchor = top|left
			# Top-right of the right page (x 812..1265, y 58..775). close is
			# datamodel row 0 by the ORDER CONTRACT in the events, so this
			# position is exact, with no invisible rows above shifting it.
			# Snug in the page's top-right corner, above the head ornament
			# (y 96..125) and just inside the deckle edge at x 1265.
			position = { 1216 60 }
			layer = top
			size = { 50 50 }
			allow_outside = yes

			fixedgridbox = {
				datamodel = "[EventWindowData.GetOptions]"
				addcolumn = 50
				addrow = 50

				item = {
					button_icon = {
						visible = "[EventOption.HasFlag('special')]"
						size = { 40 40 }
						texture = "gfx/interface/icons/flat_icons/window_close.dds"
						color = { 0.72 0.12 0.10 1 }
						onclick = "[EventOption.Select]"
						tooltip = "CLOSE_TOOLTIP"
						using = tooltip_below
					}
				}
			}
		}

		# --- copy page text: sits left of the X, folio pages only ---
		# A plain button rather than an event option: nothing to select, so it
		# lives outside the option grids and the row contract entirely.
		# CopyStringToClipboard is the explicit clipboard call; the barbershop
		# DNA buttons prove clipboard writes work outside debug mode. The
		# argument is the same resolved prose the right page is rendering, so
		# what lands on the clipboard is exactly what the reader sees,
		# formatting markers (#italic/#bold) included.
		button_copy = {
			name = "gr_book_copy_page"
			visible = "[EventWindowData.HasPortraitCharacter('left_portrait')]"
			position = { 1166 64 }
			size = { 36 36 }
			color = { 0.22 0.15 0.09 1 }
			onclick = "[EventWindowData.CopyStringToClipboard( EventWindowData.GetDescription )]"
			tooltip = "gr_book_copy_tt"
			using = tooltip_below
		}


		################################################################
		# LAYER 3 - gutter shadow, drawn last so it sits in FRONT of the
		# text and makes the pages read as inset rather than pasted on.
		# Commented out rather than visible=no: CK3 still tries to load a
		# texture on a hidden widget and logs a VFSOpen error for it.
		# Re-enable once gr_book_gutter.dds exists (soft black-to-clear
		# gradient, ~180px wide, centred on the spine at x=764).
		################################################################
