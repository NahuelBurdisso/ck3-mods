### gui119 - GUI 1.19 Patch
### Grand Remembrance 1.10.0 shows the folio portrait twice, switching on
### ShouldStylizeDeadPortrait( Character.Self ) - the CK3 1.20 'Stylize Deceased
### Characters' setting. 1.19.0.6 has no such function, both visible checks fail to
### parse and both portraits draw on top of each other. Here the plain portrait is
### always shown and the painted one never. Nothing else differs from GR's file.

gr_book_event_window = {
	name = "gr_book_event_window"
}

types GrBookWindowTypes {
	type gr_book_event_window = window {

		parentanchor = center
		widgetanchor = center
		allow_outside = yes

		# 1540 x 867 preserves the source art's 1.777 aspect (1672 x 941).
		# Page rectangles below are that art measured, scaled by 0.9211:
		#   left  page  x 274..715   y 60..773
		#   right page  x 812..1265  y 58..775
		# Everything on a page is ABSOLUTELY positioned. A vbox is wrong here:
		# a hidden widget still reserves its layout space, so the absent
		# portrait pushed the option grid clean out the bottom of the window.
		size = { 1540 867 }

		layer = events

		datacontext = "[EventWindow.AccessEventWindowData]"

		using = Event_Window_Debug_EventTools
		blockoverride "is_event_on_top" {
			enabled = "[EventWindow.IsOnTop]"
		}
		blockoverride "is_event_on_top_close" {
			trigger_when = "[Not(EventWindow.IsOnTop)]"
		}

		block "transition" {
			alpha = 0

			state = {
				name = show
				trigger_on_create = yes
				using = Animation_FadeIn_Standard
				duration = 0.7

				start_sound = {
					soundeffect = "event:/SFX/Events/Panels/sfx_event_panel_letter"
					soundparam = {
						name = StateChange
						value = 1
					}
				}
			}

			state = {
				name = _hide
				using = Animation_FadeOut_Standard
			}
		}

		event_window_dimmer_widget = {}

		################################################################
		# LAYER 1 - the book. Drawn first so everything sits on top of it.
		# alwaystransparent so it never eats a click meant for a button.
		################################################################
		icon = {
			name = "gr_book_frame"
			size = { 100% 100% }
			texture = "gfx/interface/window_gr_chronicle/gr_book_frame.dds"
			alwaystransparent = yes
		}

		################################################################
		# LAYER 1.5 - ILLUMINATED UNDERLAYS.
		# These MUST sit here, immediately after the book and before every
		# content widget. Declaration order is z-order: when they were declared
		# further down they painted over the portrait and the arms, which is
		# what produced the streaks across the face and made the tree look
		# colourless (it was being seen against a dark portrait, not parchment).
		################################################################


		# --- static underlays: cover pages and the folio's portrait page ---
		icon = {
			name = "gr_wm_cover_left"
			visible = "[Not(EventWindowData.HasPortraitCharacter('left_portrait'))]"
			# Hard into the page's bottom-LEFT corner. The texture is now cropped
			# to its content (the source carried 226px of transparent padding on
			# its right, which was holding the figure off the corner), so the
			# widget box IS the figure. Page runs x 274..715, y 60..773; this
			# sits 6px off the left edge and 8px off the foot.
			position = { 280 165 }
			size = { 316 600 }
			texture = "gfx/interface/window_gr_chronicle/gr_wm_cover_left.dds"
			alpha = 0.50
			alwaystransparent = yes
		}


		icon = {
			name = "gr_wm_cover_right"
			visible = "[Not(EventWindowData.HasPortraitCharacter('left_portrait'))]"
			# Hard into the page's bottom-RIGHT corner, mirroring the left page.
			# Source carried 169px of transparent padding on its left; cropped.
			# Page runs x 812..1265, y 58..775. Right edge lands on 1257, foot
			# on 767, so it clears the deckle by 8px on both.
			position = { 926 167 }
			size = { 331 600 }
			texture = "gfx/interface/window_gr_chronicle/gr_wm_cover_right.dds"
			alpha = 0.50
			alwaystransparent = yes
		}


		icon = {
			name = "gr_wm_folio_left"
			visible = "[EventWindowData.HasPortraitCharacter('left_portrait')]"
			position = { 286 60 }
			size = { 416 713 }
			texture = "gfx/interface/window_gr_chronicle/gr_wm_folio_left.dds"
			alpha = 0.50
			alwaystransparent = yes
		}

		widget = {
			name = "gr_folio_watermark_layer"
			# Parent gate. Everything inside is folio-only, so the cover cannot
			# show the stack even if gr_wm_id is missing and the per-icon tests
			# fail open. CK3 treats a FAILED visible expression as visible, so a
			# reliable parent condition is the only real protection.
			visible = "[EventWindowData.HasPortraitCharacter('left_portrait')]"
			position = { 0 0 }
			size = { 100% 100% }
			alwaystransparent = yes

			################################################################
			# FOLIO WATERMARK - one icon per variant.
			#
			# CK3 will not interpolate a data function into a texture path (tested
			# 2026-08-19: it opened a file literally named "[GetPlayer...]" and
			# logged VFSOpen). Texture paths must be literals, so each of the 76
			# variants needs its own icon gated on gr_wm_id. Verbose, but only one
			# is ever visible and adding the AGOT / Elder Scrolls sets is just more
			# entries in the same generated block.
			################################################################
			icon = {
				visible = "[ObjectsEqual( GetPlayer.MakeScope.Var('gr_wm').GetFlagName, 'african_01_coptic_grape_vine_knot' )]"
				position = { 823 118 }
				size = { 430 645 }
				texture = "gfx/interface/window_gr_chronicle/watermarks/african_01_coptic_grape_vine_knot.dds"
				alpha = 0.45
				alwaystransparent = yes
			}
			icon = {
